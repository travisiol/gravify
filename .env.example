# --- Brand-critical values to replace before going live -----------------------
# The address the interface presents as the official $GRAV. It currently points
# at a contract that is NOT yours — swap it for your own deployment.
NEXT_PUBLIC_GRAV_TOKEN_ADDRESS=0xcb7f25C0513c658B1510838D8Bd63d56BD8Ba2CA

# --- Chain plumbing -----------------------------------------------------------
# Uniswap-V2 style router on Robinhood Chain. Drives the pool table and the
# swap leg of the router. Leave unset to render "router not configured".
NEXT_PUBLIC_SWAP_ROUTER=0x89e5db8b5aa49aa85ac63f691524311aeb649eba

# Cross-chain messenger. While empty the bridge stays inert and the interface
# says so, which is the point.
NEXT_PUBLIC_MESSENGER=

# --- Per-asset contracts ------------------------------------------------------
# A gToken only appears as live once BOTH its vault and its token are set.
NEXT_PUBLIC_GRAV_VAULT_USDC=
NEXT_PUBLIC_GRAV_TOKEN_USDC=
NEXT_PUBLIC_GRAV_VAULT_USDT=
NEXT_PUBLIC_GRAV_TOKEN_USDT=
NEXT_PUBLIC_GRAV_VAULT_WBTC=
NEXT_PUBLIC_GRAV_TOKEN_WBTC=
NEXT_PUBLIC_GRAV_VAULT_PAXG=
NEXT_PUBLIC_GRAV_TOKEN_PAXG=
NEXT_PUBLIC_GRAV_VAULT_XAUT=
NEXT_PUBLIC_GRAV_TOKEN_XAUT=
